# Configuration JWT - À copier et modifier avant production

# Clé secrète pour signer les JWT
# ⚠️ IMPORTANT: Générer une clé sécurisée avec: openssl rand -base64 32
# Ne jamais utiliser 'your-secret-key-change-this' en production!
JWT_SECRET=your-secret-key-change-this

# Durée d'expiration des tokens (en secondes)
# Par défaut: 86400 = 24 heures
JWT_EXPIRATION=86400

# Configuration de la base de données
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=vite_gourmand
DB_PORT=3306

# Configuration du serveur
SERVER_HOST=localhost
SERVER_PORT=8000

# Mode de développement
APP_ENV=development
APP_DEBUG=true
